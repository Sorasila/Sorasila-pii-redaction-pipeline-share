# Copy this file to .env for local development. Never commit real secrets.
LLM_PROXY_BASE_URL=https://llm-proxy.example:9001
LLM_PROXY_API_KEY=replace-with-a-local-secret
LLM_PROXY_MODEL=qwen/qwen3.6-27b

# Optional: set this when the proxy uses a private CA not installed in the system trust store.
# LLM_PROXY_CA_BUNDLE=C:\path\to\internal-ca.pem

# TLS verification defaults to true. Only opt in to false for the approved
# LLM proxy exception: it removes server authentication and risks API-key/PII exposure.
# This never disables downstream TLS or the PII verification pass.
# LLM_PROXY_VERIFY_TLS=false

# Optional execution-policy overrides. Defaults apply when omitted.
# Timeouts and deadline below are seconds. Deadline is per window, including retries.
# LLM_PROXY_CONNECT_TIMEOUT_SECONDS=10
# LLM_PROXY_READ_TIMEOUT_SECONDS=300
# LLM_PROXY_WRITE_TIMEOUT_SECONDS=30
# LLM_PROXY_POOL_TIMEOUT_SECONDS=10
# LLM_PROXY_REQUEST_DEADLINE_SECONDS=600
# LLM_PROXY_MAX_RETRIES=2
# LLM_PROXY_RETRY_BACKOFF_SECONDS=1
# LLM_PROXY_RETRY_BACKOFF_CAP_SECONDS=10
# LLM_PROXY_DETECTION_USE_THINKING=false
# LLM_PROXY_VERIFICATION_USE_THINKING=false

# Service (pii_pipeline.service). The token is required: 32+ random characters.
# Generate it (and the test flag below) with:  python tools/setup_service_env.py
# PII_SERVICE_API_TOKEN=
# PII_SERVICE_REQUEST_DEADLINE_SECONDS=1200
# Off by default: the response is the redacted Markdown alone (no PII).
# PII_SERVICE_RETURN_METADATA=false
# Adds pii_manifest (and the metadata it is bound to).
# PII_SERVICE_RETURN_MANIFEST=false
# Swagger UI at /docs for trying the API (test and staging only).
# PII_SERVICE_ENABLE_DOCS=false
# Test machines only: a returned or stored manifest is then PLAINTEXT.
# PII_SERVICE_ALLOW_UNENCRYPTED_TEST_MANIFEST=false

# Optional manifest store (PostgREST), off by default: production keeps no PII.
# Unset: nothing is stored. With the unencrypted test manifest the URL must be
# this machine.
# PII_STORE_URL=http://127.0.0.1:3000
# PII_STORE_TOKEN=
